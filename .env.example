# Copie este archivo a .env y reemplace todos los marcadores.
# Nunca confirme el archivo .env en Git.

# SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=Autopartes_Gallegos
SQLSERVER_USERNAME=usuario_sql_placeholder
SQLSERVER_PASSWORD=contrasena_sql_placeholder
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server

# API FastAPI
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
API_SECRET_KEY=cambie_esta_clave_secreta

# Credenciales SAGAJI
SAGAJI_USER=usuario_sagaji_placeholder
SAGAJI_PASSWORD=contrasena_sagaji_placeholder
SAGAJI_REMEMBER=0

# Web scraping
SCRAPING_ENABLED=true
SCRAPING_DAILY_ENABLED=true
SCRAPING_DAILY_TIME=02:00
SCRAPING_TIMEZONE=America/Mexico_City
SCRAPING_REQUEST_DELAY=1.0
SCRAPING_MAX_RETRIES=3
SCRAPING_PAGE_SIZE=10